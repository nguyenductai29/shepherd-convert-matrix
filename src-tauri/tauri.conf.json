{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shepherd Master SQL Generator",
  "version": "0.1.0",
  "identifier": "jp.shepherd.master-sql-generator",
  "build": {
    "beforeDevCommand": "node scripts/desktop.mjs dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/desktop.mjs build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Shepherd Master SQL Generator",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
